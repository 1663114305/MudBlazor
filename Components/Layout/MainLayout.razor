@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span style="font-weight: bold; font-size: 1.2rem;">神动专属</span>
            <div style="margin-left: auto;">
                <!-- 仅修改退出按钮：用示例同款事件绑定语法 -->
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@((e) => Logout())">
                    退出登录
                </MudButton>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    [Inject] private NavigationManager NavManager { get; set; }

    // 退出登录方法（保持不变）
    private void Logout()
    {
        NavManager.NavigateTo("/");
    }
}

<style>
    .page {
        display: flex;
        height: 100vh;
        overflow: hidden;
    }

    .sidebar {
        width: 250px;
        background-color: #f0f2f5;
        border-right: 1px solid #ddd;
        padding: 1rem 0;
    }

    .top-row {
        background-color: #fff;
        border-bottom: 1px solid #ddd;
        padding: 1rem;
        display: flex;
        align-items: center;
    }

    .content {
        flex: 1;
        padding: 1.5rem;
        overflow-y: auto;
    }
</style>