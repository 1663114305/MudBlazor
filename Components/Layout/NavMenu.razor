@inherits LayoutComponentBase
@using BlazorApp1.Components.Models
@using MudBlazor
@inject CustomUserState UserState

    <!-- 侧边栏 -->
    <MudDrawer Open="@_sidebarOpen" Anchor="Anchor.Left   " Variant="DrawerVariant.Persistent">
        <div Style="padding: 1rem;">
            <MudNavMenu Style="background-color:#f8fafc; border-radius:4px;">
                <MudNavLink Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All" Href="/home">
                    主页
            </MudNavLink>
            @if (UserState.CurrentUser?.quanxian == 1)
            {
                <MudNavLink Icon="@Icons.Material.Filled.Download" Href="/Example_Work">
                    作品示例下载
                </MudNavLink>
            }
                
                <MudNavLink Icon="@Icons.Material.Filled.Cloud" Href="/weather">
                    天气
                </MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.List" Href="/student/list">
                    学生列表
                </MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.ChatBubble" Href="/AI_TextAPI">
                        AI对话助手
                    </MudNavLink>
                </MudNavMenu>
        </div>
    </MudDrawer>

    <!-- 主内容区 -->
    <MudMainContent>
        @Body
    </MudMainContent>


@code {
    private bool _sidebarOpen = true;

    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
    }
}