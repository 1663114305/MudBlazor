@page "/"
@using BlazorApp1.Components.Layout
@using MudBlazor
@using BlazorApp1.Components.Models 
@using Microsoft.EntityFrameworkCore 
@using Microsoft.AspNetCore.Identity 

@* 指定登录页用简化布局 *@
@layout LoginLayout
@rendermode InteractiveServer

@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject DBContext DbContext // 1. 注入数据库上下文

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div style="height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
    <MudCard Elevation="10" Style="width: 100%; max-width: 400px; margin: 16px;">
        <MudCardContent>
            <!-- 标题区域 -->
            <div style="text-align: center; margin-bottom: 30px;">
                <MudIcon Icon="Icons.Material.Filled.Lock" Color="Color.Primary" Size="Size.Large" Style="margin-bottom: 10px;" />
                <MudText Typo="Typo.h4" Color="Color.Primary">用户登录</MudText>
            </div>

            <!-- 用户名区域 -->
            <MudTextField T="string"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Placeholder="请输入用户名"
                          PrependIcon="Icons.Material.Filled.Person"
                          Style="margin-bottom: 20px;"
                          @bind-Value="Username" />

            <!-- 密码区域 -->
            <MudTextField T="string"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          InputType="InputType.Password"
                          Placeholder="请输入密码"
                          PrependIcon="Icons.Material.Filled.Lock"
                          Style="margin-bottom: 10px;"
                          @bind-Value="Password" />

            <!-- 登录按钮 -->
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="mt-4"
                       StartIcon="@Icons.Material.Filled.Send"
                       @onclick="HandleLogin"
                       Disabled="isLoggingIn">
                @(isLoggingIn ? "登录中..." : "登录")
            </MudButton>

            <!-- 注册链接 -->
            <div style="text-align: center; margin-top: 20px;">
                <MudText Typo="Typo.body2">还没有账号？<MudLink Href="/Register" Color="Color.Primary">去注册</MudLink></MudText>
            </div>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private string Username { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private bool isLoggingIn = false; // 用于显示加载状态

    // 2. 将方法修改为 async Task
    private async Task HandleLogin()
    {
        if (isLoggingIn) return; // 防止重复点击

        // 基本输入验证
        if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password))
        {
            Snackbar.Add("用户名和密码不能为空！", Severity.Error);
            return;
        }

        isLoggingIn = true;
        try
        {
            // 3. 从数据库中查询用户
            var userFromDb = await DbContext.Login_db
                                            .Where(u => u.Username == Username)
                                            .FirstOrDefaultAsync();


            if (userFromDb == null)
            {
                // 用户不存在，为了安全，提示可以模糊一点
                Snackbar.Add("用户名或密码错误，请重试！", Severity.Error);
            }
            else
            {
                // 5. 验证输入的密码与数据库中的哈希值是否匹配
                // PasswordVerificationResult.Success 表示匹配成功
                if (userFromDb.PasswordHash == Password)
                {
                    // 密码正确，登录成功
                    Snackbar.Add("登录成功！", Severity.Success);
                    // 导航到主页或其他受保护的页面
                    NavManager.NavigateTo("/home");
                }
                else
                {
                    // 密码错误
                    Snackbar.Add("用户名或密码错误，请重试！", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            // 处理可能发生的异常，如数据库连接问题
            Snackbar.Add($"登录失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            isLoggingIn = false; // 无论成功失败，都恢复按钮状态
        }
    }
}