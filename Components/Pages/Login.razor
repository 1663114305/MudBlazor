@page "/"
@using BlazorApp1.Components.Layout
@using MudBlazor
@* 关键：指定登录页用简化布局 *@
@layout LoginLayout
@rendermode InteractiveServer

@inject NavigationManager NavManager
@inject ISnackbar Snackbar




<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div style="height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
    <MudCard Elevation="10" Style="width: 100%; max-width: 400px; margin: 16px;">
        <MudCardContent>
            <!-- 标题区域 -->
            <div style="text-align: center; margin-bottom: 30px;">
                <MudIcon Icon="Icons.Material.Filled.Lock" Color="Color.Primary" Size="Size.Large" Style="margin-bottom: 10px;" />
                <MudText Typo="Typo.h4" Color="Color.Primary">用户登录</MudText>
            </div>

            <!-- 用户名区域 -->
            <MudText Typo="Typo.body1" Style="margin-bottom: 8px; font-weight: 500;">用户名</MudText>
            <MudTextField T="string"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Placeholder="请输入用户名"
                          PrependIcon="Icons.Material.Filled.Person"
                          Style="margin-bottom: 20px;"
                          @bind-Value="Username" />

            <!-- 密码区域 -->
            <MudText Typo="Typo.body1" Style="margin-bottom: 8px; font-weight: 500;">密码</MudText>
            <MudTextField T="string"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          InputType="InputType.Password"
                          Placeholder="请输入密码"
                          PrependIcon="Icons.Material.Filled.Lock"
                          Style="margin-bottom: 10px;"
                          @bind-Value="Password" />

            <!-- 登录按钮 -->
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Style="margin-top: 20px;"
                       @onclick="HandleLogin">
                登录
            </MudButton>

        </MudCardContent>
    </MudCard>
</div>

@code {
    private string Username { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;

    private readonly List<(string Username, string Password)> _validUsers = new()
    {
        ("admin", "123456"),
        ("root", "123456")
    };

    private void HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password))
        {
            Snackbar.Add("用户名和密码不能为空！", Severity.Error);
            return;
        }

        bool isValidUser = _validUsers.Any(user =>
            user.Username.Equals(Username, StringComparison.OrdinalIgnoreCase) &&
            user.Password == Password);

        if (isValidUser)
        {
            Snackbar.Add("登录成功！", Severity.Success);
            NavManager.NavigateTo("/home");
        }
        else
        {
            Snackbar.Add("用户名或密码错误，请重试！", Severity.Error);
        }
    }
}