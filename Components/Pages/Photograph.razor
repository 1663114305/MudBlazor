@page "/Photograph"
@using System.Text
@using MudBlazor
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using BlazorApp1.Components.Models
@using Microsoft.EntityFrameworkCore
@inject IWebHostEnvironment WebHostEnv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject CustomUserState UserState
@inject DBContext DbContext
@rendermode InteractiveServer

<PageTitle>照片集</PageTitle>

<MudFileUpload T="IBrowserFile"
               FilesChanged="@FilesChanged"
               OnFilesChanged="@OnFilesChanged"
               Style="text-align: right; width: 100%;">
    <ActivatorContent>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.CloudUpload">
            上传图片
        </MudButton>
    </ActivatorContent>
</MudFileUpload>

<!-- 照片显示区域（原有代码完全不变） -->
<div style="max-width: 1200px; margin: 0px auto 0; padding: 20px;">
    <MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary">
        <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Class="mr-2" />
        我的照片集
    </MudText>

    <MudGrid Spacing="3" Justify="Justify.FlexStart">

        @if (photos != null && photos.Any())
        {
            @foreach (var photo in photos)
            {
                var temophoto = photo;
                <MudItem xs="12" sm="6" md="4" lg="3">                  
                        <MudCard Class="h-100" Style="cursor: pointer;">
                            <MudCardContent>
                                <div style="height: 200px; border-radius: 8px; overflow: hidden;">
                                    <img src="@photo.FilePath" style="width: 100%; height: 100%; object-fit: cover;" alt="图片丢失" />
                                </div>
                                <div class="mt-3">
                                    <MudText Typo="Typo.body2" Class="mb-1">照片描述：@photo.Description</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        上传时间：@photo.UploadTime.ToString("yyyy-MM-dd HH:mm:ss")
                                    </MudText>
                                </div>
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility">查看</MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit">修改</MudButton>
                            <MudSwitch @bind-Value="temophoto.IsPublic"
                                       Size="Size.Small"
                                       Class="mx-2"
                                       Color="@(temophoto.IsPublic? Color.Success: Color.Error)"
                                       @bind-Value:after="() => TogglePhotoPublic(temophoto)" >
                                       公开
                                   </MudSwitch>
                            <div style="flex-grow: 1"></div>
                                <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default" Size="Size.Small" />
                            </MudCardActions>
                        </MudCard>
                </MudItem>
            }
        }
        else
        {
            <!-- 无照片提示（保持原有简洁结构） -->
            <div style="position: relative; width: 100%; display: flex; justify-content: center;">
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Class="h-100" Style="cursor: pointer;">
                        <MudCardContent>
                            <div style="height: 200px; background: linear-gradient(45deg, #f5f7fa 0%, #c3cfe2 100%); display: flex; align-items: center; justify-content: center; border-radius: 8px;">
                                <MudIcon Icon="@Icons.Material.Filled.Photo" Size="Size.Large" Color="Color.Primary" />
                            </div>
                            <div class="mt-3">
                                <MudText Typo="Typo.body2" Class="mb-1">暂无照片</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">上传后将显示在这里</MudText>
                            </div>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" Disabled="true">查看</MudButton>
                            <div style="flex-grow: 1"></div>
                            <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default" Size="Size.Small" Disabled="true" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 10;">
                    <MudFileUpload T="IBrowserFile" FilesChanged="@FilesChanged" OnFilesChanged="@OnFilesChanged">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">上传图片</MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </div>
            </div>
        }

    </MudGrid>
</div>

<style>
    .h-100 {
        height: 100%;
    }

    .mud-card:hover {
        transform: translateY(-4px);
        transition: transform 0.2s ease-in-out;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1) !important;
    }

    .rounded-pill {
        border-radius: 50rem !important;
    }
</style>

@code {

    // 临时存储选中的文件（用于OnFilesChanged中处理）
    private IBrowserFile? _selectedFile;
    // 存储查询到的照片路径
    private List<Photo>? photos = new List<Photo>();

    private bool _hasRestoredUserState = false;

    /// <summary>
    /// FilesChanged事件（MudFileUpload封装后的事件，参数为IBrowserFile）
    /// </summary>
    private void FilesChanged(IBrowserFile? file)
    {
        _selectedFile = file; // 缓存选中的文件，供OnFilesChanged使用
    }
    // 组件初始化时加载照片
    protected override async Task OnInitializedAsync()
    {
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasRestoredUserState)
        {
            await UserState.RestoreUserState();
            _hasRestoredUserState = true;
            photos = await Inquiry_photo();
            StateHasChanged();
        }
    }

    /// <summary>
    /// OnFilesChanged事件（原生InputFile的事件，参数为InputFileChangeEventArgs）
    /// </summary>
    private async void OnFilesChanged(InputFileChangeEventArgs e)
    {

        try
        {
            // 优先使用FilesChanged缓存的文件，或从e中获取
            var file = _selectedFile ?? (e.FileCount > 0 ? e.File : null);
            if (file == null)
            {
                Snackbar.Add("未选择任何图片", Severity.Info);
                return;
            }

            // 1. 校验文件格式（仅允许图片）
            var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif", "image/webp" };
            if (!allowedTypes.Contains(file.ContentType))
            {
                Snackbar.Add($"不支持的格式：{file.ContentType}，仅允许jpg/png/gif/webp", Severity.Error);
                return;
            }

            // 2. 构建保存目录（wwwroot/Photo）
            var photoDir = Path.Combine(WebHostEnv.WebRootPath, "Photo");
            if (!Directory.Exists(photoDir)) Directory.CreateDirectory(photoDir);

            // 3. 生成唯一文件名
            var safeFileName = Path.GetFileName(file.Name)
                                   .Replace("\\", "")
                                   .Replace("/", "")
                                   .Replace(":", "")
                                   .Replace("*", "")
                                   .Replace("?", "")
                                   .Replace("\"", "")
                                   .Replace("<", "")
                                   .Replace(">", "")
                                   .Replace("|", "");
            var uniqueFileName = $"{DateTime.Now:yyyyMMddHHmmssfff}_{safeFileName}";
            var savePath = Path.Combine(photoDir, uniqueFileName);

            // 4. 保存文件到目录
            using (var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)) // 10MB限制
            using (var fileStream = new FileStream(savePath, FileMode.Create))
            {
                await stream.CopyToAsync(fileStream);
            }

            Snackbar.Add($"照片「{file.Name}」上传成功！", Severity.Success);
            var photo = new Photo
            {
                // 从UserState获取用户名（你的自定义状态服务）
                Username = UserState.CurrentUser?.Username ?? string.Empty,
                // 生成的唯一文件名（存储到数据库的文件名）
                FileName = uniqueFileName,
                // 文件原始名称（用户上传的原文件名）
                OriginalFileName = file.Name,
                // 文件存储路径（相对路径/绝对路径，这里用相对路径更适配部署）
                FilePath = $"/Photo/{uniqueFileName}", // 前端可直接通过/Photo/xxx访问
                // 文件大小（字节）
                FileSize = file.Size,
                // 文件类型（MIME类型，如image/jpeg）
                FileType = file.ContentType,
                // 上传时间（默认是DateTime.Now，显式赋值更清晰）
                UploadTime = DateTime.Now,
                // 是否公开（使用默认值true，无需手动赋值，也可显式写）
                IsPublic = false,
            };
            DbContext.Photos.Add(photo);
            await DbContext.SaveChangesAsync();

            Console.WriteLine($"图片已保存：{savePath}");
            photos = await Inquiry_photo();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"上传失败：{ex.Message}\n{ex.StackTrace}");
            Snackbar.Add($"上传失败：{ex.Message}", Severity.Error);
        }
    }


    private async Task<List<Photo>> Inquiry_photo()
    {
        if (UserState == null || UserState.CurrentUser == null || string.IsNullOrEmpty(UserState.CurrentUser.Username))
        {
            // 返回空列表，避免查询报错
            return new List<Photo>();
        }
        List<Photo> photoPaths = await DbContext.Photos
            .Where(u => u.Username == UserState.CurrentUser.Username)
            .ToListAsync();
        return photoPaths;
    }
    private async Task TogglePhotoPublic(Photo photo)
    {
        DbContext.Photos.Update(photo);
        await DbContext.SaveChangesAsync();
    }

  



}
