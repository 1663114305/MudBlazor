@page "/student/list"
@using BlazorApp1.Models
@using BlazorApp1.Data
@inject IStudentRepository Repository

<h3>学生列表</h3>

<p class="text-right">
    <a class="btn btn-primary" href="/student/add">Add</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Sex</th>
            <th>Class</th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @if (_students != null)
        {
            foreach (var item in _students)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Age</td>
                    <td>@item.Sex</td>
                    <td>@item.Class</td>
                    <td>
                        <a class="btn btn-primary" href="/student/modify/@item.Id">修改</a>
                        <a class="btn btn-danger" href="/student/delete/@item.Id">删除</a>
                    </td>
                </tr>
            }
        }

    </tbody>
</table>

@code {
    private List<Student> _students;

    protected override void OnInitialized()
    {
        _students = Repository.List();
    }
}