@page "/weather"
@attribute [StreamRendering]
@using System.Net.Http
@using System.Net.Http.Headers
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization

@inject HttpClient Http

<PageTitle>Weather</PageTitle>

<h1>天气查询</h1>
