<!-- 加载/错误提示 -->
@if (isLoading)
{
    <p><em>正在查询天气数据...</em></p>
}
else if (!string.IsNullOrEmpty(errorMsg))
{
    <div class="alert alert-danger">@errorMsg</div>
}

<!-- 天气数据展示 -->
@if (weatherData != null && weatherData.Data != null && weatherData.Data.Data != null)
{
    <!-- 实时天气 -->
    <div class="card mb-4">
        <div class="card-header">
            <h5>@weatherData.Data.Data.City 实时天气</h5>
            <small>更新时间：@weatherData.Data.Data.UpdateTimeFormat</small>
        </div>
        <div class="card-body">
            <ul class="list-group">
                <li class="list-group-item">天气状况：@weatherData.Data.Data.Day.Phrase (@weatherData.Data.Data.Day.Temperature)℃</li>
                <li class="list-group-item">体感温度：@weatherData.Data.Data.Day.FeelsLike℃</li>
                <li class="list-group-item">湿度：@weatherData.Data.Data.Day.Humidity%</li>
                <li class="list-group-item">风向：@weatherData.Data.Data.Day.WindDirCompass 风速：@weatherData.Data.Data.Day.WindSpeed km/h</li>
                <li class="list-group-item">紫外线指数：@weatherData.Data.Data.Day.UvIndex (@weatherData.Data.Data.Day.UvDescription)</li>
                <li class="list-group-item">空气质量：@weatherData.Data.Data.Day.Air (@weatherData.Data.Data.Day.Air_level)</li>
            </ul>
        </div>
    </div>

    <!-- 小时预报（前12小时） -->
    @if (weatherData.Data.Data.Hours != null && weatherData.Data.Data.Hours.Any())
    {
        <div class="card mb-4">
            <div class="card-header"><h5>未来12小时预报</h5></div>
            <div class="card-body">
                <div class="row row-cols-4 g-2">
                    @foreach (var hour in weatherData.Data.Data.Hours.Take(12))
                    {
                        <div class="col">
                            <div class="card text-center p-2">
                                <p class="mb-1 small">@hour.Time</p>
                                <p class="mb-1">@hour.Wea</p>
                                <p class="mb-0">@hour.Tem℃（体感@hour.Temfeels℃）</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- 15天预报 -->
    @if (weatherData.Data.Data.Month != null && weatherData.Data.Data.Month.Any())
    {
        <div class="card mb-4">
            <div class="card-header"><h5>未来15天预报</h5></div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>日期</th>
                            <th>星期</th>
                            <th>白天天气</th>
                            <th>白天温度</th>
                            <th>夜间天气</th>
                            <th>夜间温度</th>
                            <th>空气质量</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in weatherData.Data.Data.Month)
                        {
                            <tr>
                                <td>@day.Date</td>
                                <td>@day.DateOfWeek</td>
                                <td>@day.Day.Phrase</td>
                                <td>@day.Day.Temperature℃</td>
                                <td>@day.Night.Phrase</td>
                                <td>@day.Night.Temperature℃</td>
                                <td>@day.Air (@day.Air_level)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    // API配置（替换为你的有效AppCode）
    private const string AppCode = "5107c03a86654ea0b2a65979400c05c4";
    private const string ApiUrl = "https://sdtqz.market.alicloudapi.com/api/weather/fifteen/forty";

    // 页面状态
    private string selectedCity = "广州";
    private bool isLoading = false;
    private string errorMsg = string.Empty;
    private WeatherResponse? weatherData;

    /// <summary>
    /// 核心查询方法（一次请求成功）
    /// </summary>
    private async Task QueryWeather()
    {
        isLoading = true;
        errorMsg = string.Empty;
        weatherData = null;
        StateHasChanged();

        try
        {
            // 构建请求参数（去空格，避免无效请求）
            var bodyParams = new Dictionary<string, string>
            {
                { "city", selectedCity.Trim() },
                { "aqi", "1" }
            };
            var content = new FormUrlEncodedContent(bodyParams);

            // 构建请求（严格符合API要求）
            var request = new HttpRequestMessage(HttpMethod.Post, ApiUrl)
            {
                Content = content
            };
            request.Headers.Add("Authorization", $"APPCODE {AppCode}");
            request.Content.Headers.ContentType = new MediaTypeHeaderValue("application/x-www-form-urlencoded")
            {
                CharSet = "UTF-8"
            };

            // 仅一次请求，避免API浪费
            var response = await Http.SendAsync(request);
            var responseContent = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"API响应：{responseContent}");

            // 校验响应状态
            if (!response.IsSuccessStatusCode)
            {
                errorMsg = $"API请求失败【{response.StatusCode}】：{responseContent}";
                return;
            }
            if (string.IsNullOrWhiteSpace(responseContent))
            {
                errorMsg = "API返回空内容，请求无效";
                return;
            }

            // 解析配置（仅必要兼容，无多余转换）
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
                // 兼容字符串/数字互转（仅针对少数混合字段）
                NumberHandling = JsonNumberHandling.AllowReadingFromString
            };

            // 解析（模型100%匹配，一次成功）
            weatherData = JsonSerializer.Deserialize<WeatherResponse>(responseContent, options);

            // 校验业务状态
            if (weatherData == null || !weatherData.Success || weatherData.Data?.Data == null)
            {
                errorMsg = $"查询失败：{(weatherData?.Msg ?? "无返回信息")}";
                weatherData = null;
            }
        }
        catch (JsonException ex)
        {
            errorMsg = $"JSON解析失败【精准定位】：{ex.Message}（行{ex.LineNumber}，列{ex.BytePositionInLine}）";
        }
        catch (HttpRequestException ex)
        {
            errorMsg = $"网络请求失败：{ex.Message}（请检查API域名是否可访问）";
        }
        catch (Exception ex)
        {
            errorMsg = $"未知错误：{ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

