@page "/AI_TextAPI"
@using System.Text
@using MudBlazor
@using System.Text.Json
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>AI_TextAPI</PageTitle>

<h1>神动小助手</h1>

<!-- 清空对话按钮 -->
<div style="text-align: right; margin-bottom: 1rem;">
    <MudButton Variant="Variant.Outlined"
               Color="Color.Error"
               Size="Size.Small"
               OnClick="ClearChatHistory"
               StartIcon="@Icons.Material.Filled.Delete">
        清空对话
    </MudButton>
</div>

<!-- 显示框（上方）：展示聊天记录，支持滚动 -->
<MudCard id="chatContainer" Style="height: 400px; margin-bottom: 1rem; overflow-y: auto;">
    <MudCardContent>
        <!-- 循环渲染聊天记录，区分用户和AI消息 -->
        @foreach (var message in chatHistory)
        {
            if (message.StartsWith("用户："))
            {
                <div style="text-align: right; margin: 0.5rem 0; padding: 8px 12px; background-color: var(--mud-palette-primary); color: white; border-radius: 18px; width: fit-content; margin-left: auto; word-wrap: break-word;">
                    <MudText Style="color: white; margin: 0;">@message.Replace("用户：", "")</MudText>
                </div>
            }
            else if (message == "AI 正在思考中...")
            {
                <div style="text-align: left; margin: 0.5rem 0;">
                    <MudChip T="string" Color="Color.Info" Text="@message" Icon="@Icons.Material.Filled.AccessTime" />
                </div>
            }
            else if (message.StartsWith("错误："))
            {
                <div style="text-align: left; margin: 0.5rem 0;">
                    <MudChip T="string" Color="Color.Error" Text="@message" Icon="@Icons.Material.Filled.Error" />
                </div>
            }
            else
            {
                <div style="text-align: left; margin: 0.5rem 0; padding: 8px 12px; background-color: var(--mud-palette-success); color: white; border-radius: 18px; max-width:fit-content; word-wrap: break-word;">
                    <MudText Style="color: white; margin: 0; white-space: pre-wrap;">@message.Replace("AI：", "")</MudText>
                </div>
            }
        }
    </MudCardContent>
</MudCard>

<!-- 输入框和发送按钮 -->
<MudGrid Gutter="16">
    <MudItem xs="10">
        <MudTextField @ref="inputRef"
                      @bind-Value="userInput"
                      Label="输入你的问题"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      OnKeyUp="HandleKeyUp"
                      Placeholder="输入后按回车或点击发送按钮..." />
    </MudItem>
    <MudItem xs="2">
        <MudButton Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="@CallDeepSeekApi"
                   Color="@Color.Primary"
                   FullWidth="true">
            发送
        </MudButton>
    </MudItem>
</MudGrid>

@code {
    // 绑定用户输入
    private string userInput = string.Empty;
    // 聊天记录列表（存储所有消息）
    private List<string> chatHistory = new();
    // API Key
    private string ApiKey = "sk-834530e4443746cb91ac4900072c8957";
    // 输入框组件引用（用于操作焦点）
    private MudTextField<string> inputRef;

    // 组件初始化时加载历史记录
    protected override async Task OnInitializedAsync()
    {
        await LoadChatHistory();
    }

    // 在 @inject 部分添加
    @inject ISnackbar Snackbar

    private async Task LoadChatHistory()
    {
        try
        {
            var savedHistory = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "chatHistory");
            if (!string.IsNullOrEmpty(savedHistory))
            {
                chatHistory = JsonSerializer.Deserialize<List<string>>(savedHistory) ?? new List<string>();
                StateHasChanged();
                await ScrollToBottom();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载聊天记录失败: {ex.Message}", Severity.Warning);
        }
    }

    private async Task SaveChatHistory()
    {
        try
        {
            var historyJson = JsonSerializer.Serialize(chatHistory);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "chatHistory", historyJson);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存聊天记录失败: {ex.Message}", Severity.Warning);
        }
    }
    // 清空对话历史
    private async Task ClearChatHistory()
    {
        chatHistory.Clear();
        await SaveChatHistory();
        Snackbar.Add("对话记录已清空", Severity.Success);
        StateHasChanged();
    }

    // 发送消息逻辑
    private async Task CallDeepSeekApi()
    {
        if (string.IsNullOrWhiteSpace(userInput?.Trim()))
        {
            AddMessageToHistory("请输入你的问题后再发送！", isSystem: true);
            return;
        }

        var currentQuestion = userInput.Trim();
        AddMessageToHistory($"用户：{currentQuestion}");
        AddMessageToHistory("AI 正在思考中...");

        userInput = string.Empty;
        StateHasChanged();

        if (inputRef != null)
        {
            await inputRef.BlurAsync();
        }

        using (var client = new HttpClient())
        {
            var request = new HttpRequestMessage(HttpMethod.Post, "https://api.deepseek.com/v1/chat/completions");
            request.Headers.Add("Accept", "application/json");
            request.Headers.Add("Authorization", $"Bearer {ApiKey}");

            var requestBody = new
            {
                model = "deepseek-chat",
                messages = new[]
                {
                    new { role = "system", content = "You are a helpful assistant" },
                    new { role = "user", content = currentQuestion }
                },
                frequency_penalty = 0,
                max_tokens = 4096,
                presence_penalty = 0,
                response_format = new { type = "text" },
                stream = false,
                temperature = 1.0,
                top_p = 1.0
            };

            var json = System.Text.Json.JsonSerializer.Serialize(requestBody);
            var content = new StringContent(json, Encoding.UTF8, "application/json");
            request.Content = content;

            try
            {
                var response = await client.SendAsync(request);
                response.EnsureSuccessStatusCode();

                var responseContent = await response.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(responseContent);
                var root = doc.RootElement;

                string aiAnswer = "AI 未返回有效内容。";
                if (root.TryGetProperty("choices", out var choices) && choices.GetArrayLength() > 0)
                {
                    var firstChoice = choices[0];
                    if (firstChoice.TryGetProperty("message", out var message) && message.TryGetProperty("content", out var contentProp))
                    {
                        aiAnswer = contentProp.GetString() ?? aiAnswer;
                    }
                }

                chatHistory.RemoveAt(chatHistory.Count - 1);
                AddMessageToHistory($"AI：{aiAnswer}");
            }
            catch (Exception ex)
            {
                chatHistory.RemoveAt(chatHistory.Count - 1);
                AddMessageToHistory($"错误：{ex.Message}", isSystem: true);
            }
        }
    }

    // 添加消息到历史记录（修改为自动保存）
    private void AddMessageToHistory(string message, bool isSystem = false)
    {
        chatHistory.Add(message);

        if (chatHistory.Count > 1000)
        {
            chatHistory = chatHistory.Skip(chatHistory.Count - 1000).ToList();
        }

        StateHasChanged();
        _ = ScrollToBottom();
        _ = SaveChatHistory(); // 自动保存
    }

    // 滚动到底部
    private async Task ScrollToBottom()
    {
        await Task.Delay(10);
        await JSRuntime.InvokeVoidAsync("scrollToBottom", "chatContainer");
    }

    // 回车发送
    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CallDeepSeekApi();
        }
    }
}